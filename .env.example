# ==============================================================================
# RADAR SHOPEE - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHOPEE AFFILIATE OPEN API (Credenciais Oficiais)
# ------------------------------------------------------------------------------
# Obtenha em: https://affiliate.shopee.com.br/ -> Open Platform
SHOPEE_APP_ID=seu_shopee_app_id_aqui
SHOPEE_SECRET=sua_shopee_secret_key_aqui
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# ------------------------------------------------------------------------------
# 2. SUPABASE (Banco de Dados PostgreSQL e API)
# ------------------------------------------------------------------------------
# Obtenha nas configurações do projeto Supabase -> Project Settings -> Database
POSTGRES_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_do_banco_supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT API
# ------------------------------------------------------------------------------
# Crie seu bot no @BotFather para obter o token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Seu chat_id pessoal de administrador para receber alertas de erro e relatórios diários
# (Consulte enviando uma mensagem para o bot @userinfobot ou @getidsbot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (Geração de Legendas/Copys)
# ------------------------------------------------------------------------------
# Pode ser OpenAI (GPT-4o-mini / GPT-4o) ou Gemini (via endpoint compatível OpenAI)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Para utilizar Google Gemini via compatibilidade OpenAI:
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_API_KEY=sua_chave_gemini_aqui
# AI_MODEL=gemini-1.5-flash

