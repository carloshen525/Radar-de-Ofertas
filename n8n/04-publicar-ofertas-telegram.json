{
  "name": "Radar Shopee - 04. Publicar Ofertas Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 8-22 * * *"
            }
          ]
        }
      },
      "id": "40000004-0000-0000-0000-000000000001",
      "name": "Fila a cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nome, imagem, preco, preco_antigo, desconto, legenda_ia, url_afiliado, score\nFROM products\nWHERE status = 'aprovado' AND legenda_ia IS NOT NULL AND legenda_ia != ''\nORDER BY score DESC, created_at ASC\nLIMIT 1;"
      },
      "id": "40000004-0000-0000-0000-000000000002",
      "name": "Buscar Melhor Oferta Pronta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [420, 300],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nome, chat_id, tipo FROM telegram_channels WHERE ativo = true AND tipo IN ('canal', 'grupo');"
      },
      "id": "40000004-0000-0000-0000-000000000003",
      "name": "Buscar Canais Ativos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [640, 300],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const produto = $('Buscar Melhor Oferta Pronta').first()?.json;\nconst canais = $('Buscar Canais Ativos').all().map(c => c.json);\n\nif (!produto || !produto.id) {\n  return [];\n}\n\n// Prepara a combinação de produto x canais para checagem de duplicidade\nconst tarefas = [];\nfor (const canal of canais) {\n  tarefas.push({\n    json: {\n      product_id: produto.id,\n      nome_produto: produto.nome,\n      imagem: produto.imagem,\n      legenda_ia: produto.legenda_ia,\n      url_afiliado: produto.url_afiliado,\n      chat_id: canal.chat_id,\n      nome_canal: canal.nome\n    }\n  });\n}\n\nreturn tarefas;"
      },
      "id": "40000004-0000-0000-0000-000000000004",
      "name": "Cruzar Oferta com Canais",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM publications\nWHERE product_id = '{{ $json.product_id }}' AND telegram_channel = '{{ $json.chat_id }}'\nLIMIT 1;"
      },
      "id": "40000004-0000-0000-0000-000000000005",
      "name": "Verificar Duplicidade no Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1080, 300],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition_duplicidade",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "40000004-0000-0000-0000-000000000006",
      "name": "Se Nao Foi Publicado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendPhoto",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Cruzar Oferta com Canais').item.json.chat_id }}\",\n  \"photo\": \"{{ $('Cruzar Oferta com Canais').item.json.imagem }}\",\n  \"caption\": {{ JSON.stringify($('Cruzar Oferta com Canais').item.json.legenda_ia) }},\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [\n        {\n          \"text\": \"🛒 Comprar agora\",\n          \"url\": \"{{ $('Cruzar Oferta com Canais').item.json.url_afiliado }}\"\n        }\n      ]\n    ]\n  }\n}"
      },
      "id": "40000004-0000-0000-0000-000000000007",
      "name": "Enviar Foto e Botao Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO publications (product_id, telegram_channel, telegram_message_id, status)\nVALUES (\n  '{{ $('Cruzar Oferta com Canais').item.json.product_id }}',\n  '{{ $('Cruzar Oferta com Canais').item.json.chat_id }}',\n  {{ $json.result?.message_id || 'NULL' }},\n  'publicado'\n)\nON CONFLICT (product_id, telegram_channel) DO NOTHING;\n\nUPDATE products\nSET status = 'publicado', updated_at = NOW()\nWHERE id = '{{ $('Cruzar Oferta com Canais').item.json.product_id }}';"
      },
      "id": "40000004-0000-0000-0000-000000000008",
      "name": "Registrar Publicacao no Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1740, 200],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    }
  ],
