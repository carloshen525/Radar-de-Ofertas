{
  "name": "Radar Shopee - 05. Relatório Diário",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 22 * * *"
            }
          ]
        }
      },
      "id": "50000005-0000-0000-0000-000000000001",
      "name": "Disparo Diário (22:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM v_relatorio_diario;"
      },
      "id": "50000005-0000-0000-0000-000000000002",
      "name": "Consultar Metricas do Dia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [420, 300],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chat_id FROM telegram_channels WHERE tipo = 'admin' AND ativo = true LIMIT 1;"
      },
      "id": "50000005-0000-0000-0000-000000000003",
      "name": "Buscar ChatId do Admin",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [640, 300],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const metrics = $('Consultar Metricas do Dia').first()?.json || {};\nconst adminChat = $('Buscar ChatId do Admin').first()?.json?.chat_id || $env.TELEGRAM_ADMIN_CHAT_ID;\n\nconst encontrados = metrics.produtos_encontrados || 0;\nconst aprovados = metrics.produtos_aprovados || 0;\nconst publicados = metrics.produtos_publicados || 0;\nconst erros = metrics.total_erros || 0;\n\nconst dataAtual = new Date().toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nconst textoRelatorio = `📊 *Relatório Radar Shopee* - ${dataAtual}\\n\\n` +\n  `🔍 *Produtos encontrados:* ${encontrados}\\n` +\n  `✅ *Aprovados:* ${aprovados}\\n` +\n  `🚀 *Publicados:* ${publicados}\\n` +\n  `⚠️ *Erros:* ${erros}\\n\\n` +\n  `⚡ _Status do Sistema: ${erros === 0 ? '🟢 100% Operacional' : '🟡 Atenção com logs de erro'}_`;\n\nreturn [{\n  json: {\n    chat_id: adminChat,\n    texto: textoRelatorio\n  }\n}];"
      },
      "id": "50000005-0000-0000-0000-000000000004",
      "name": "Formatar Texto do Relatório",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.chat_id }}\",\n  \"text\": \"{{ $json.texto }}\",\n  \"parse_mode\": \"Markdown\"\n}"
      },
      "id": "50000005-0000-0000-0000-000000000005",
      "name": "Enviar Relatorio Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_logs (workflow, status, detalhes)\nVALUES (\n  '05_relatorio_diario',\n  'sucesso',\n  json_build_object('data', NOW())\n);"
      },
      "id": "50000005-0000-0000-0000-000000000006",
      "name": "Registrar Log Relatorio",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1300, 300],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres_credential",
          "name": "Supabase Postgres"
        }
      }
    }
  ],
  "connections": {
    "Disparo Diário (22:00)": {
      "main": [
        [
          {
            "node": "Consultar Metricas do Dia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar Metricas do Dia": {
      "main": [
        [
          {
            "node": "Buscar ChatId do Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar ChatId do Admin": {
      "main": [
        [
          {
            "node": "Formatar Texto do Relatório",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatar Texto do Relatório": {
      "main": [
        [
          {
            "node": "Enviar Relatorio Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Relatorio Telegram": {
      "main": [
        [
          {
            "node": "Registrar Log Relatorio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

